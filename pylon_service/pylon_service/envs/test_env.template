# Bittensor network, eg. finney or ws://127.0.0.1:9944
PYLON_BITTENSOR_NETWORK=finney
# Directory in which the wallets are located (if using docker, it must point to the directory inside the container).
PYLON_BITTENSOR_WALLET_PATH=~/.bittensor/wallets

# Path to the pylon database file. Must point to the existing directory. The file will be created if it does not exist.
# Leave empty to use the default database location `./pylon.db` inside the container.
PYLON_DATABASE_PATH=

# Identities configuration. Here, names of configured identities are listed (json list).
PYLON_IDENTITIES=["sn12"]

# Configuration for identity named sn12.
# UID of bittensor subnet, eg. 12
PYLON_ID_SN12_NETUID=12
# Name of your wallet located inside BITTENSOR_WALLET_PATH, it will be used by this identity.
PYLON_ID_SN12_WALLET_NAME=my_wallet
# Name of the wallet hotkey that will be used by this identity.
PYLON_ID_SN12_HOTKEY_NAME=my_hotkey
# Token with which the user will authenticate to pylon to use this identity. Keep it secret.
PYLON_ID_SN12_TOKEN=my_secure_token

# EVM main RPC URL for recent blocks. Default: https://lite.chain.opentensor.ai
PYLON_EVM_RPC_URL=
# EVM archive RPC URL for reading historical logs. Default: https://archive.chain.opentensor.ai
PYLON_EVM_ARCHIVE_RPC_URL=
# Number of blocks from the chain head below which archive RPC is used. Default is 300.
PYLON_EVM_ARCHIVE_BLOCKS_CUTOFF=

# Deployment environment name. Single source of truth used by both Sentry and OTEL log resource attributes.
PYLON_ENVIRONMENT=development

# Service version reported in OTEL log resource attributes. Injected automatically at Docker build time
# (via the SERVICE_VERSION build-arg); leave empty for local runs.
PYLON_OTEL_SERVICE_VERSION=

# OTEL deployment environment name. Defaults to PYLON_ENVIRONMENT when left commented out.
# To override, uncomment the line below and set a non-empty value (an empty value would disable the fallback).
# PYLON_OTEL_DEPLOYMENT_ENVIRONMENT=

# OTLP traces exporter endpoint - base URL of the collector, e.g. http://alloy:4318.
# Leave empty to disable OpenTelemetry traces (disabled by default). When set, traces are exported via
# OTLP HTTP/protobuf to <endpoint>/v1/traces, and the Litestar HTTP server plus the httpx, aiohttp
# and SQLAlchemy libraries are auto-instrumented. You must run your own OTLP collector at this address.
PYLON_OTEL_COLLECTOR_ENDPOINT=

# Sentry Configuration
# DSN address for pylon to use - leave empty to disable sentry integration.
PYLON_SENTRY_DSN=

# Sentry environment name. Defaults to PYLON_ENVIRONMENT when left commented out.
# To override, uncomment the line below and set a non-empty value (an empty value would disable the fallback).
# PYLON_SENTRY_ENVIRONMENT=

# Token for accessing /metrics endpoint. Must be passed as Bearer token in Authorization header.
# If empty, /metrics endpoint will return 403 Forbidden.
PYLON_METRICS_TOKEN=

# Settings for proactive caching of recent objects.

# Soft and hard limits is the time in block unit (1 block = 12 seconds) for which data is considered fresh.
# If data is older than soft limit, it will still be returned, but with warning that it is stale.
# If data is older than hard limit, it will be considered stale and not returned.
# The default value for soft limit is 100 blocks, and hard limit is 150 blocks.
PYLON_RECENT_OBJECTS_SOFT_LIMIT_BLOCKS=
PYLON_RECENT_OBJECTS_HARD_LIMIT_BLOCKS=

# Number of blocks before soft limit to start updating the cache. Default value is 10
# Example, if soft limit is 100 and lead blocks is 5, cache will be updated after 95 blocks.
PYLON_RECENT_OBJECTS_REFRESH_LEAD_BLOCKS=

# List of subnets for which recent objects should be cached. Recent objects will be cached for these subnets, plus
# any other subnets identities are configured for.
PYLON_RECENT_OBJECTS_NETUIDS=
